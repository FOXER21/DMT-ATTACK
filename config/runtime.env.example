#!/usr/bin/env bash
# Copy to config/runtime.env and edit the host-specific paths.

export DMT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHON_BIN="${PYTHON_BIN:-python3.10}"

# Public model layout. See models/README.md.
export DMT_MODEL_ROOT="${DMT_MODEL_ROOT:-/path/to/models}"
export DMT_SD_MODEL="${DMT_SD_MODEL:-${DMT_MODEL_ROOT}/stable-diffusion-2-1}"
export DMT_PI05_MODEL="${DMT_PI05_MODEL:-${DMT_MODEL_ROOT}/pi05_libero}"
export DMT_PI0_MODEL="${DMT_PI0_MODEL:-${DMT_MODEL_ROOT}/pi0_libero_finetuned_v044}"
export DMT_TOKENIZER="${DMT_TOKENIZER:-${DMT_MODEL_ROOT}/gemma-tokenizer}"

# LIBERO assets and optional external source/runtime roots.
export LIBERO_ASSETS_DIR="${LIBERO_ASSETS_DIR:-/path/to/libero/libero/assets}"
export DMT_LIBERO_ROOT="${DMT_LIBERO_ROOT:-/path/to/libero/libero}"
export DMT_EXTRA_DEPS="${DMT_EXTRA_DEPS:-}"
export DMT_LEROBOT_SRC="${DMT_LEROBOT_SRC:-}"
export DMT_TOOLS="${DMT_TOOLS:-}"
export PYTHONPATH="${DMT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"

export MUJOCO_GL="${MUJOCO_GL:-egl}"
export PYOPENGL_PLATFORM="${PYOPENGL_PLATFORM:-egl}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
export HF_ENDPOINT="${HF_ENDPOINT:-https://huggingface.co}"
